# Used by agent, hybrid, and policy RAG generation. Copy to .env and supply your values.
GROQ_API_KEY=
LLM_PROVIDER=groq
# Supply an available Groq model ID; agent mode needs tool calling.
LLM_MODEL=
# Legacy GROQ_MODEL is also accepted when LLM_MODEL is empty.

# vector (default): local MiniLM embeddings + persistent Chroma. Or keyword.
RAG_BACKEND=vector
# Leave blank to use the project's .data/chroma directory.
CHROMA_DB_DIR=
# Cosine distance cutoff: lower is stricter. Tune against your policy questions.
RAG_MAX_DISTANCE=0.65
